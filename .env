# ═══════════════════════════════════════════════════════════
# DS-Copilot Environment Configuration
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values

# === App ===
APP_NAME=DS-Copilot
DEBUG=true
SECRET_KEY=change-me-in-production-use-a-random-string

# === LLM Providers (set at least one) ===
OPENAI_API_KEY=lm-studio
OPENAI_API_BASE=http://127.0.0.1:1234/v1
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# === Ollama (local LLM, no key needed) ===
OLLAMA_BASE_URL=http://localhost:11434

# === Default LLM Settings ===
DEFAULT_LLM_PROVIDER=openai
DEFAULT_MODEL=qwen/qwen3-v1-4b
DEFAULT_TEMPERATURE=0.1
DEFAULT_MAX_TOKENS=4096

# === Code Execution ===
DEFAULT_EXECUTION_ENV=local
E2B_API_KEY=e2b_c1b49234658d5648fb6058a310af7a7cde50505e
LOCAL_SANDBOX_DIR=./sandbox

# === Database ===
DATABASE_URL=sqlite:///./ds_copilot.db
REDIS_URL=redis://localhost:6379

# === Git ===
ENABLE_GIT=true
GIT_AUTO_COMMIT=true

# === Output ===
OUTPUT_DIR=./output
MAX_RETRIES=3
API_CALL_BUDGET=100
